# never commit the corpus or extracted PDFs (copyrighted source)
text/
gdrive_download/

# databases are local build state (regenerate with kb/ scripts)
cote_kb.db
search.db
*.sqlite
*.sqlite3

# python noise
__pycache__/
*.pyc

# wrangler local dev state (Pages Functions / local D1)
.wrangler/
node_modules/

# build workspace: share/ is regenerated by kb/build_share_site.py;
# docs/ is the copy GitHub Pages serves
share/
_sitecheck/

# restructure snapshots and audit data are regenerable working state
.restructure/
site-audit/*.json
site-audit/*.csv
site-audit/graph.html

# a chat transcript is not part of the archive
session-*.md
